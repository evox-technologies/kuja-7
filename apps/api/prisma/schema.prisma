generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
}

model Profile {
  id          String   @id @default(uuid())
  supabaseId  String   @unique
  email       String   @unique
  role        Role     @default(USER)
  firstName   String
  lastName    String
  gender      Gender
  dateOfBirth DateTime
  religion    String?
  profession  String?
  location    String?
  bio         String?
  avatarUrl   String?
  isVerified  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Extended personal info
  nationality   String?
  height        String?
  ethnicity     String?
  caste         String?
  civilStatus   String?

  // Structured residency
  country       String?
  city          String?
  stateDistrict String?

  // Education & habits
  educationLevel String?
  drinking       String?
  smoking        String?
  foodPreference String?

  // Horoscope
  kujaNumber String?
  birthDay   String?

  // Private contact (only visible to mutual matches who accepted contact request)
  mobileNumber   String?
  whatsappNumber String?
  address        String?
  images         String[]

  // True once all mandatory profile fields are filled in
  profileCompleted Boolean @default(false)

  sentInterests     Interest[]     @relation("SentInterests")
  receivedInterests Interest[]     @relation("ReceivedInterests")
  shortlisted       Shortlist[]    @relation("ShortlistedBy")
  shortlistedBy     Shortlist[]    @relation("ShortlistedUser")
  sentMessages      Message[]      @relation("SentMessages")
  conversations1    Conversation[] @relation("Participant1")
  conversations2    Conversation[] @relation("Participant2")

  contactRequestsSent     ContactRequest[] @relation("ContactRequestsSent")
  contactRequestsReceived ContactRequest[] @relation("ContactRequestsReceived")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsCaused   Notification[] @relation("NotificationActor")

  @@map("profiles")
}

model Interest {
  id         String         @id @default(uuid())
  senderId   String
  receiverId String
  status     InterestStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sender   Profile @relation("SentInterests", fields: [senderId], references: [id])
  receiver Profile @relation("ReceivedInterests", fields: [receiverId], references: [id])

  notifications Notification[]

  @@unique([senderId, receiverId])
  @@map("interests")
}

model Shortlist {
  id        String   @id @default(uuid())
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   Profile @relation("ShortlistedBy", fields: [userId], references: [id])
  target Profile @relation("ShortlistedUser", fields: [targetId], references: [id])

  @@unique([userId, targetId])
  @@map("shortlists")
}

model Conversation {
  id             String    @id @default(uuid())
  participant1Id String
  participant2Id String
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  participant1 Profile   @relation("Participant1", fields: [participant1Id], references: [id])
  participant2 Profile   @relation("Participant2", fields: [participant2Id], references: [id])
  messages     Message[]

  @@unique([participant1Id, participant2Id])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       Profile      @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model ContactRequest {
  id          String               @id @default(uuid())
  requesterId String
  targetId    String
  status      ContactRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  requester Profile @relation("ContactRequestsSent", fields: [requesterId], references: [id])
  target    Profile @relation("ContactRequestsReceived", fields: [targetId], references: [id])

  @@unique([requesterId, targetId])
  @@map("contact_requests")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  recipientId String
  recipient   Profile @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String
  actor   Profile @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  interestId String?
  interest   Interest? @relation(fields: [interestId], references: [id], onDelete: SetNull)

  @@index([recipientId, read])
  @@map("notifications")
}
