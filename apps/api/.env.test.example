# Config for `npm run test:integration`.
#
# The integration suite truncates every table, so this MUST point at a
# throwaway local database — the setup guard rejects any non-local host.
#
# Spin one up with:
#   docker run -d --name kuja7-test-db \
#     -e POSTGRES_PASSWORD=testpass -e POSTGRES_USER=postgres \
#     -e POSTGRES_DB=kuja7test -p 55432:5432 postgres:17
#   npm run test:db:push

DATABASE_URL="postgresql://postgres:testpass@localhost:55432/kuja7test"
DIRECT_URL="postgresql://postgres:testpass@localhost:55432/kuja7test"
